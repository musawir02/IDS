# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Main contact form and Digital Marketing Packages landing page enquiry emails.
# Server-side only: never prefix these with VITE_. Missing values don't stop the server;
# the form then shows "Not sent" with the WhatsApp alternative.
# SMTP_SECURE=true for implicit TLS (usually port 465); otherwise STARTTLS is required.
SMTP_HOST="MY_SMTP_HOST"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="MY_SMTP_USERNAME"
SMTP_PASS="MY_SMTP_PASSWORD"
# Sending address and name, for example "IDS Website <sender@example.com>"
SMTP_FROM="MY_SENDER_NAME <MY_SENDER_ADDRESS>"
# Recipient of the enquiry emails (not the sending account)
LEAD_TO_EMAIL="MY_ENQUIRY_RECIPIENT"
# Overall limit of enquiry emails per hour (default 30)
LEAD_MAX_EMAILS_PER_HOUR="30"

# How Express reads the visitor IP behind the hosting proxy, for the per-IP rate limit.
# Use only the proxy's address (loopback, uniquelocal, an IP or CIDR range) or a verified
# hop count. "true" is rejected. While unset, the per-IP limit is off.
TRUST_PROXY=""
